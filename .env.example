# Frontend (Vite). Only VITE_-prefixed vars reach the browser bundle.
# Set this to the HTTPS URL of the separately hosted Drawgon API in Vercel.
# Never put database URLs or server secrets in this file.
VITE_API_URL=https://api.example.com

# tldraw SDK licence key. Required for any non-localhost deployment: without
# it LicenseManager resolves to "unlicensed-production" and LicenseProvider
# swaps the canvas for a hidden div 5 seconds after mount. localhost is exempt
# (getIsDevelopment() treats plain http as development), so this only ever
# breaks in production. Vite inlines it at build time, so set it in the
# hosting provider's environment variables before building.
VITE_TLDRAW_LICENSE_KEY=
